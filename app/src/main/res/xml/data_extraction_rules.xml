<?xml version="1.0" encoding="utf-8"?>
<!-- The session lives in Keystore-encrypted preferences, which cannot be restored on another device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
